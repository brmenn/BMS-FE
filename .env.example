# Base URL of the Laravel API. Leave empty to use the Vite dev proxy (same-origin),
# which keeps the browser free of CORS/Sanctum stateful-domain concerns.
VITE_API_BASE_URL=

# Versioned prefix; every request path in src/lib/api is appended to this.
VITE_API_PREFIX=/api/v1

VITE_APP_NAME=Amburadul
